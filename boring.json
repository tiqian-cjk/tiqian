// tiqian's Haxe build and test project (boring feature spec 59). The driver derives every
// output directory (<outRoot>/<id>/gen and <outRoot>/<id>/gen-tests) and every
// results path (<resultsDir>/<id>.jsonl) from this file; none is named here.
//
//   each configuration's run.env carries the per-test budget the repository records
//   (600000 ms): the boring runtime falls back to a 6 s budget when
//   BORING_TEST_TIMEOUT_MS is unset, and eleven cases of this suite run longer
//   than that on this machine, so they would be reported as timeouts.
// The flake pins the boring compiler and driver to one revision. Each Rust
// package declares its own metadata below; the generator does not borrow
// tiqian's license from the boring repository.
{
  "outRoot": "engine-haxe/out",
  "resultsDir": "engine-haxe/out/test-results",
  "baseline": "kotlin-f32",
  "sourceRoots": ["engine-haxe/src", "engine-haxe/macros"],
  "sourceSets": {
    "engine": {
      "types": ["runtime.UString", "runtime.TestCore", "org.tiqian.protocol.NamedErrorNames", "org.tiqian.core.FittedLinePatternGeometry", "org.tiqian.core.RichTextLayoutProjection"],
      "discover": [
        {
          "root": "engine-haxe/src",
          "packages": [
            "org.tiqian.core", "org.tiqian.layout", "org.tiqian.font",
            "org.tiqian.clreq", "org.tiqian.shaping", "org.tiqian.linebreak"
          ],
          "suffix": "Test"
        }
      ]
    }
  },
  "bundles": [
    {
      "id": "kotlin-f32",
      "target": "kotlin",
      "sourceSet": "engine",
      "rootsFile": "engine-haxe/targets/kotlin-f32.hxml",
      "haxeArgs": ["-D", "package-artifact-stem=tiqian-engine"],
      "mavenPublication": { "command": "./gradlew", "args": [":engine:publishToMavenLocal", "-Dmaven.repo.local={maven}", "-PtiqianVersion={version}", "--no-daemon"] },
      "package": { "name": "tiqian-engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "kotlin-f64",
      "target": "kotlin",
      "sourceSet": "engine",
      "rootsFile": "engine-haxe/targets/kotlin-f64.hxml",
      "haxeArgs": ["-D", "package-artifact-stem=tiqian-engine-f64"],
      "package": { "name": "tiqian-engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "ts",
      "target": "ts",
      "sourceSet": "engine",
      "rootsFile": "engine-haxe/targets/ts.hxml",
      "package": { "name": "tiqian-engine", "npmName": "@tiqian/engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "swift-f32",
      "target": "swift",
      "sourceSet": "engine",
      "rootsFile": "engine-haxe/targets/swift-f32.hxml",
      "haxeArgs": ["-D", "package-artifact-stem=tiqian-engine-f32"],
      "package": { "name": "tiqian-engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "swift-f64",
      "target": "swift",
      "sourceSet": "engine",
      "rootsFile": "engine-haxe/targets/swift-f64.hxml",
      "haxeArgs": ["-D", "package-artifact-stem=tiqian-engine-f64"],
      "package": { "name": "tiqian-engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "dart",
      "target": "dart",
      "sourceSet": "engine",
      "rootsFile": "engine-haxe/targets/dart.hxml",
      "package": { "name": "tiqian-engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "protocol-ts",
      "compare": false,
      "target": "ts",
      "rootsFile": "engine-haxe/targets/protocol-ts.hxml",
      "package": { "name": "tiqian-protocol", "npmName": "@tiqian/protocol", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "shared-ts",
      "compare": false,
      "target": "ts",
      "rootsFile": "platforms/web/shared/targets/shared-ts.hxml",
      "package": { "name": "tiqian-shared", "npmName": "@tiqian/shared", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "protocol-rust",
      "compare": false,
      "target": "rust",
      "rootsFile": "engine-haxe/targets/protocol-rust.hxml",
      "package": { "name": "tiqian-protocol", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
        {
      "id": "protocol-dart",
      "compare": false,
      "target": "dart",
      "rootsFile": "engine-haxe/targets/protocol-dart.hxml",
      "package": {
        "name": "tiqian-protocol",
        "version": "0.1.0",
        "license": "MPL-2.0"
      },
      "run": {
        "env": {
          "BORING_TEST_TIMEOUT_MS": "600000"
        }
      }
    },
{
      "id": "protocol-kotlin",
      "compare": false,
      "target": "kotlin",
      "rootsFile": "engine-haxe/targets/protocol-kotlin.hxml",
      "package": { "name": "tiqian-protocol", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "protocol-swift",
      "compare": false,
      "target": "swift",
      "rootsFile": "engine-haxe/targets/protocol-swift.hxml",
      "package": { "name": "tiqian-protocol", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
    {
      "id": "engine-rust",
      "target": "rust",
      "sourceSet": "engine",
      "rootsFile": "engine-haxe/targets/rust.hxml",
      "package": { "name": "tiqian-engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    }
  ]
}
