// tiqian's Haxe build and test project (boring feature spec 59). The driver derives every
// output directory (<outRoot>/<id>/gen and <outRoot>/<id>/gen-tests) and every
// results path (<resultsDir>/<id>.jsonl) from this file; none is named here.
//
// This file is the single generation entry. The project haxeArgs carry what every
// bundle shares, each bundle's own haxeArgs carry its target arguments and its module
// roots, and each engine bundle takes its engine roots from a source set. The
// hand-written roots hxml files that used to supply the same arguments alongside this
// file are gone, so there is no second copy of them that could drift.
//
//   each configuration's run.env carries the per-test budget the repository records
//   (600000 ms): the boring runtime falls back to a 6 s budget when
//   BORING_TEST_TIMEOUT_MS is unset, and eleven cases of this suite run longer
//   than that on this machine, so they would be reported as timeouts.
// The flake pins the boring compiler and driver to one revision. Each Rust
// package declares its own metadata below; the generator does not borrow
// tiqian's license from the boring repository.
//
// Argument order matters where roots are concerned: the driver sorts a source
// set's roots, while module roots written in haxeArgs keep their order, and that
// order reaches the generated text. engine-rust therefore takes its own source
// set: the rust target also roots the std.UStringException sample module. The
// three swift bundles state -D swift-test-import=TiqianEngine in their haxeArgs,
// and the driver reads the library module name from those same arguments.
//
// Keep every comment above this line. The staging pipeline parses the text from
// the first opening brace as strict JSON, so a comment inside the object body is
// fatal to it while the driver's own parser would accept the file. The leading
// paragraph must hold no brace either: the pipeline starts at the first one it
// finds, and a brace inside a comment starts the parse inside that comment.
//
{
  "outRoot": "engine-haxe/out",
  "resultsDir": "engine-haxe/out/test-results",
  "baseline": "kotlin-f32",
  "sourceRoots": ["engine-haxe/src", "engine-haxe/macros"],
  "haxeArgs": [
    "-lib", "reflaxe",
    "-lib", "boring",
    "-cp", ".haxelib/boring/git/samples",
    "--macro", "haxe.macro.Compiler.addGlobalMetadata('org.tiqian', '@:build(std.RecordMember.build())')"
  ],
  "sourceSets": {
    "engine": {
      "types": [
        "runtime.UString",
        "runtime.TestCore",
        "org.tiqian.protocol.NamedErrorNames",
        "org.tiqian.core.FittedLinePatternGeometry",
        "org.tiqian.core.RichTextLayoutProjection",
        "org.tiqian.font.FontRoleClassification"
      ],
      "discover": [
        {
          "root": "engine-haxe/src",
          "packages": [
            "org.tiqian.core",
            "org.tiqian.layout",
            "org.tiqian.font",
            "org.tiqian.clreq",
            "org.tiqian.shaping",
            "org.tiqian.linebreak"
          ],
          "suffix": "Test"
        }
      ]
    },
    "engine-rust": {
      "types": [
        "runtime.UString",
        "runtime.TestCore",
        "org.tiqian.protocol.NamedErrorNames",
        "org.tiqian.core.FittedLinePatternGeometry",
        "org.tiqian.core.RichTextLayoutProjection",
        "std.UStringException"
      ],
      "discover": [
        {
          "root": "engine-haxe/src",
          "packages": [
            "org.tiqian.core",
            "org.tiqian.layout",
            "org.tiqian.font",
            "org.tiqian.clreq",
            "org.tiqian.shaping",
            "org.tiqian.linebreak"
          ],
          "suffix": "Test"
        }
      ]
    }
  },
  "bundles": [
    {
      "id": "kotlin-f32",
      "target": "kotlin",
      "precision": "f32",
      "sourceSet": "engine",
      "haxeArgs": [
        "-cp", ".haxelib/boring/git/packages/compiler/reflaxe/kotlin/std-shadow",
        "-cp", ".haxelib/boring/git/packages/compiler/reflaxe/kotlin",
        "-cp", "engine-haxe/tests",
        "--macro", "Intercept.run(['engine-haxe/src', 'engine-haxe/tests'])",
        "--macro", "kotlincompiler.Compiler.use()",
        "-D", "runtime-import=org.tiqian.boring.runtime",
        "-D", "runtime-emit=runtime",
        "-D", "package-artifact-stem=tiqian-engine"
      ],
      "kmpPublication": true,
      "package": { "name": "tiqian-engine", "version": "0.1.0", "license": "MPL-2.0" },
      "run": {
        "env": { "BORING_TEST_TIMEOUT_MS": "600000" }
      }
    },
