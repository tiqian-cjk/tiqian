{
  "name": "@tiqian/ffi",
  "version": "0.1.0-alpha.9",
  "description": "Kotlin/JS engine face for Tiqian paragraph precompute.",
  "keywords": [
    "cjk",
    "chinese",
    "typography",
    "kotlin-js"
  ],
  "homepage": "https://github.com/tiqian-cjk/tiqian#readme",
  "bugs": {
    "url": "https://github.com/tiqian-cjk/tiqian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiqian-cjk/tiqian.git",
    "directory": "platforms/web/client/engine-runtime"
  },
  "license": "MPL-2.0",
  "type": "module",
  "main": "./runtime/facade.mjs",
  "types": "./runtime/facade.d.mts",
  "exports": {
    ".": {
      "types": "./runtime/facade.d.mts",
      "default": "./runtime/facade.mjs"
    },
    "./engine-gen/*": "./runtime/engine-gen/*"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build:runtime": "node ./build-runtime.ts",
    "prepare": "node ./build-runtime.ts --install-hook",
    "pretest": "node ./check-engine-gen.ts && tsc -b",
    "test": "node --test *.test.mjs",
    "verify:package": "node ./verify-package.ts",
    "verify:release": "npm run prepack && node ./verify-release.ts",
    "release:prepare": "node ./prepare-release.ts",
    "prepack": "npm run build:runtime && npm test && npm run verify:package"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.15.29"
  },
  "files": [
    "LICENSE",
    "README.md",
    "runtime/",
    "engine-gen/"
  ]
}
