{
  "name": "@tiqian/react",
  "version": "0.1.0-alpha.6",
  "description": "Reference React binding for Tiqian's CJK paragraph layout engine, held directly over the neutral core.",
  "keywords": [
    "cjk",
    "chinese",
    "typography",
    "prose",
    "layout",
    "react"
  ],
  "homepage": "https://github.com/tiqian-cjk/tiqian#readme",
  "bugs": {
    "url": "https://github.com/tiqian-cjk/tiqian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiqian-cjk/tiqian.git",
    "directory": "platforms/web/client/react"
  },
  "license": "MPL-2.0",
  "private": true,
  "files": [
    "binding.js",
    "binding.d.ts"
  ],
  "type": "module",
  "main": "./binding.js",
  "module": "./binding.js",
  "types": "./binding.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
