{
  "name": "@tiqian/sveltekit",
  "version": "0.1.0-alpha.16",
  "description": "SvelteKit integration for @tiqian/web-component.",
  "license": "MPL-2.0",
  "type": "module",
  "svelte": "./TiqianProse.svelte",
  "types": "./index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "TiqianProse.svelte",
    "index.d.ts",
    "server.d.ts",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "svelte": "./TiqianProse.svelte",
      "default": "./TiqianProse.svelte"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tiqian/core": "0.1.0-alpha.16"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0 || ^3.0.0",
    "@tiqian/precompute": "0.1.0-alpha.16",
    "@tiqian/web-component": "0.1.0-alpha.16",
    "svelte": ">=5"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.2.0",
    "@tiqian/precompute": "0.1.0-alpha.16",
    "@tiqian/web-component": "0.1.0-alpha.16",
    "svelte": "5.57.1"
  },
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "tsc -p . && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiqian-cjk/tiqian.git",
    "directory": "platforms/web/client/sveltekit"
  }
}
