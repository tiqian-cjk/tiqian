# Shared (web-only) TypeScript generation entry.
# Run from the worktree root:
#   nix develop -c bash -c 'boring gen shared-ts --project boring.json'
# Shared compiler configuration for every engine-haxe generation entry.
-lib reflaxe
-lib boring
-cp .haxelib/boring/git/samples
-cp engine-haxe/src
-cp engine-haxe/macros
-cp shared-haxe/src
--macro haxe.macro.Compiler.addGlobalMetadata('org.tiqian', '@:build(std.RecordMember.build())')
-cp .haxelib/boring/git/packages/compiler/reflaxe/ts/std-shadow
-cp .haxelib/boring/git/packages/compiler/reflaxe/ts
--macro Intercept.run(['engine-haxe/src', '.haxelib/boring/git/samples', 'shared-haxe/src'])
--macro tscompiler.Compiler.use()
-D ts-test-runner=bun
-D tiqian_ts
# The runtime is emitted into the package root, so the specifier stays
# relative: the package shell rejects a by-name import (boring
# tscompiler/Compiler.hx:611 requires a relative specifier).
-D runtime-import=./runtime.js
-D runtime-emit=.
-D package-shell=none
org.tiqian.shared.prepared_dom.Markup
org.tiqian.shared.prepared_dom.MarkupTest
org.tiqian.shared.prepared_dom.PreparedDom
org.tiqian.shared.prepared_dom.Evidence
org.tiqian.shared.prepared_dom.EvidenceTest
org.tiqian.shared.prepared_dom.PreparedArtifact
org.tiqian.shared.prepared_dom.PreparedArtifactTest
org.tiqian.shared.prepared_dom.PreparedDomTest
org.tiqian.shared.html.CompoundSelector
org.tiqian.shared.html.DomAttribute
org.tiqian.shared.html.DomNode
org.tiqian.shared.html.DomParser
org.tiqian.shared.html.HtmlAttributeInsertion
org.tiqian.shared.html.HtmlError
org.tiqian.shared.html.HtmlNameCase
org.tiqian.shared.html.HtmlOpeningTag
org.tiqian.shared.html.HtmlParseException
org.tiqian.shared.html.HtmlScan
org.tiqian.shared.SnapshotValueStyle
org.tiqian.shared.ValueStyleInterner
org.tiqian.shared.snapshot.SnapshotSource
