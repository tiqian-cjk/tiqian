# Stage A Dart generation entry for the all-target f64 consistency
# matrix (no float-precision define; full Float precision). Mirrors
# core-kotlin.hxml module coverage. Run from the worktree root:
#   nix develop -c bash -c 'haxe engine-haxe/core-dart.hxml.hxml'
-lib reflaxe
-lib boring
-cp .haxelib/boring/git/packages/compiler/reflaxe/dart/std-shadow
-cp .haxelib/boring/git/packages/compiler/reflaxe/dart
-cp .haxelib/boring/git/samples
-cp engine-haxe/src
-cp engine-haxe/macros
--macro Intercept.run(['engine-haxe/src'])
--macro GoldenDataMacros.init()
--macro haxe.macro.Compiler.addGlobalMetadata('org.tiqian', '@:build(std.RecordMember.build())')
--macro dartcompiler.Compiler.use()
-D dart-output=engine-haxe/out/dart-gen
-D dart-test-output=engine-haxe/out/dart-gen-tests
-D dart-test-runner=native
-D runtime-import=@tiqian/runtime
-D runtime-emit=.
